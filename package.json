    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/tiro-devanagari-sanskrit": "^5.3.0",
    "@fontsource/yatra-one": "^5.3.0",
    "firebase": "^13.0.0",
    "konva": "^10.7.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
